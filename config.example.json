{
  "control_addr": "127.0.0.1:8080",
  "control_token": "replace-with-a-long-random-token",
  "nodes": [
    {
      "name": "primary",
      "listen_addr": "127.0.0.1:6432",
      "upstream_addr": "127.0.0.1:5432",
      "check_command": "psql \"postgresql://dbuser:dbpass@127.0.0.1:5432/appdb\" -t -c \"{query}\""
    },
    {
      "name": "replica-1",
      "listen_addr": "127.0.0.1:6433",
      "upstream_addr": "127.0.0.1:5433",
      "check_command": "psql \"postgresql://dbuser:dbpass@127.0.0.1:5433/appdb\" -t -c \"{query}\""
    },
    {
      "name": "replica-2",
      "listen_addr": "127.0.0.1:6434",
      "upstream_addr": "127.0.0.1:5434",
      "check_command": "psql \"postgresql://dbuser:dbpass@127.0.0.1:5434/appdb\" -t -c \"{query}\""
    }
  ],
  "scenarios": [
    {
      "name": "replica-lag",
      "description": "replica-1 falls behind: added latency plus intermittent drops on its replication path",
      "steps": [
        { "node": "replica-1", "kind": "latency", "latency_ms": 2000, "after_ms": 0 },
        { "node": "replica-1", "kind": "drop", "drop_percent": 15, "after_ms": 0 }
      ]
    },
    {
      "name": "split-brain",
      "description": "Cluster splits: primary and replica-1 isolated from replica-2",
      "steps": [
        { "node": "primary", "kind": "partition", "after_ms": 0 },
        { "node": "replica-1", "kind": "partition", "after_ms": 0 }
      ]
    },
    {
      "name": "primary-crash",
      "description": "Primary crashes outright partway through a batch of writes",
      "steps": [
        { "node": "primary", "kind": "crash", "after_ms": 3000 }
      ]
    }
  ]
}
